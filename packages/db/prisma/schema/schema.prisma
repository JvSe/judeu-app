// Schema mantido só para db push / evolução. Runtime do app usa supabase-js.
generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  PROVIDER
  BOTH

  @@map("role")
}

enum ProviderStatus {
  PENDING
  APPROVED
  BLOCKED

  @@map("providerstatus")
}

enum OrderStatus {
  CREATED
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED

  @@map("orderstatus")
}

enum PaymentMethod {
  PIX
  CARD
  CASH

  @@map("paymentmethod")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@map("paymentstatus")
}

enum WalletTxType {
  CREDIT
  DEBIT

  @@map("wallettxtype")
}

enum AiRole {
  USER
  ASSISTANT
  TOOL

  @@map("airole")
}

enum NotificationType {
  ORDER
  MESSAGE
  SUPPORT
  JOB

  @@map("notificationtype")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED

  @@map("proposalstatus")
}

enum JobContractType {
  CLT
  PJ
  FREELANCE
  TEMPORARY

  @@map("jobcontracttype")
}

enum JobStatus {
  OPEN
  CLOSED

  @@map("jobstatus")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum JobApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("jobapplicationstatus")
}

// ---------------------------------------------------------------------------
// Identidade e autenticação (auth custom — email/senha via API própria)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role     @default(CLIENT)
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  pushToken     String? // Expo push token do último dispositivo logado (RF-E2)
  // Preferências do centro de notificações in-app (RF-I1) — desligar um tipo
  // suprime tanto a notificação persistida quanto o push desse evento.
  notifyOrders   Boolean  @default(true)
  notifyMessages Boolean  @default(true)
  // Consentimento explícito aos Termos de Uso/Política de Privacidade no cadastro (RNF-4, LGPD).
  termsAcceptedAt DateTime?
  // Como conheceu o app (CAC por canal) e código de convite/parceiro digitado no cadastro.
  acquisitionChannel String?
  acquisitionCode    String?
  // Modo família: contato que acompanha os pedidos pelo link e recebe e-mails.
  trustedContactName  String?
  trustedContactEmail String?
  // Suspensão da conta (cliente ou quem atende) — não entra nem renova sessão.
  blockedAt     DateTime?
  blockedReason String?
  // Opcional, informado pela própria pessoa (F | M | OTHER) — filtro "só mulheres".
  gender        String?
  // Marca a conta como excluída (RF-A7) sem quebrar FKs de pedidos/avaliações/mensagens já
  // existentes — os dados pessoais são anonimizados, o registro em si é preservado.
  deletedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerProfile     ProviderProfile?
  addresses           Address[]
  ordersAsClient      Order[]              @relation("ClientOrders")
  reviewsAuthored     Review[]             @relation("ReviewAuthor")
  reviewsReceived     Review[]             @relation("ReviewTarget")
  messages            Message[]
  wallet              Wallet?
  refreshTokens       RefreshToken[]
  aiConversations     AiConversation[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  supportTickets      SupportTicket[]
  jobApplications     JobApplication[]
  appEvents           AppEvent[]
  payoutAccount       PayoutAccount?
  payouts             Payout[]

  @@index([role])
  @@map("user")
}

// Sessão persistida: refresh tokens rotacionáveis (hash guardado, nunca o token puro)
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  // Aparelho que abriu a sessão (quem atende: um aparelho por vez).
  deviceId  String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refreshtoken")
}

// Recuperação de senha (RF-A4): código de 6 dígitos com TTL curto, hash guardado
// (nunca o código puro), mesmo padrão do RefreshToken.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passwordresettoken")
}

// Centro de notificações in-app (RF-I1): espelha cada push disparado pelo domínio
// (novo pedido, transição de status, mensagem de chat) para o usuário poder ver
// o histórico dentro do app, além de receber a notificação do sistema.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Prestador (perfil profissional + KYC)
// ---------------------------------------------------------------------------

model ProviderProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  headline        String? // ex.: "Eletricista"
  bio             String?
  yearsExperience Int            @default(0)
  status          ProviderStatus @default(PENDING)
  isAvailable     Boolean        @default(false)
  // Conta de cliente que atende ajudas abertas, sem ofício nem tabela de preço.
  // Não entra no catálogo de prestadores profissionais.
  isHelper        Boolean        @default(false)
  // Perfil de pessoa jurídica (empresa) em vez de profissional autônomo.
  isCompany       Boolean        @default(false)
  // Razão social/nome fantasia (isCompany=true) — exibido como dado secundário; o nome
  // principal mostrado ao cliente passa a ser responsibleName nesse caso.
  companyName     String?
  // Nome do responsável pela empresa (isCompany=true) — usado como nome de referência
  // do prestador no lugar do nome da empresa.
  responsibleName String?
  // Empresa (isCompany=true) que está com vagas abertas pra contratar funcionários.
  hiringEmployees Boolean        @default(false)
  // Permite ao cliente propor/receber um orçamento diferente antes do aceite (RF-D5).
  // Desligado por padrão: o fluxo segue direto pra tela de pagamento após criar o pedido.
  allowsNegotiation Boolean      @default(false)
  ratingAvg       Float          @default(0)
  ratingCount     Int            @default(0)
  documentUrl     String? // documento de verificação (KYC) no Supabase Storage
  selfieUrl          String? // selfie tirada pela câmera (KYC v2)
  lastSelfieAt       DateTime?
  // Reverificação pendente (selfie aleatória antes de começar, ou aparelho novo).
  reverifyRequiredAt DateTime?
  reverifyReason     String?
  backgroundCheckUrl String? // certidão de antecedentes criminais (KYC v2)
  // localização base + raio de atuação (matching por proximidade)
  baseLat         Float?
  baseLng         Float?
  serviceRadiusKm Float          @default(10)
  // GPS ao vivo enquanto o prestador está online (pin no mapa do cliente).
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]
  categories      ProviderCategory[]
  ordersAsProvider Order[]           @relation("ProviderOrders")
  jobPostings     JobPosting[]

  badges     ProviderBadge[]
  anchorShifts AnchorShift[]

  @@index([status, isAvailable])
  @@map("providerprofile")
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  icon      String?
  // Taxa da plataforma desta categoria; null = usa a geral (AppConfig).
  feeRate   Float?
  // Nível de risco: 1 livre · 2 selo de reparos · 3 profissional com credencial · 4 proibido.
  riskLevel Int      @default(1)
  // Duração típica do serviço; null = padrão da configuração (alerta de tempo excedido).
  expectedDurationMin Int?
  createdAt DateTime @default(now())

  services   Service[]
  providers  ProviderCategory[]
  orders     Order[]
  jobPostings JobPosting[]

  @@map("category")
}

// join m2m explícito prestador <-> categoria
model ProviderCategory {
  providerId String
  categoryId String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("providercategory")
}

model Service {
  id         String   @id @default(uuid())
  providerId String
  categoryId String
  name       String
  priceCents Int
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@index([providerId])
  @@index([categoryId])
  @@map("service")
}

// ---------------------------------------------------------------------------
// Endereços do cliente (pipeline CEP->endereço->coordenadas)
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @default(uuid())
  userId       String
  label        String? // ex.: "Casa", "Trabalho"
  cep          String?
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  lat          Float // coordenadas resolvidas via Nominatim (1x no cadastro)
  lng          Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropoffOrders Order[] @relation("OrderDropoff")
  pickupOrders  Order[] @relation("OrderPickup")

  @@index([userId])
  @@map("address")
}

// ---------------------------------------------------------------------------
// Pedido / Contratação (coração do marketplace)
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid())
  clientId        String
  providerId      String?
  serviceId       String?
  categoryId      String?
  addressId       String
  pickupAddressId String?
  // true = pedido no ar, qualquer prestador perto pode atender; false = chamada dirigida a uma pessoa.
  isOpenRequest   Boolean     @default(false)
  // Solicitação aberta: cliente marcou locais (ou optou por combinar no chat) e pode seguir o trajeto.
  detailsReady    Boolean     @default(false)
  description     String?
  status          OrderStatus @default(CREATED)
  scheduledAt     DateTime? // null = "agora"; preenchido = agendado
  priceCents      Int         @default(0)
  platformFeeCents Int        @default(0)
  totalCents      Int         @default(0)
  // Regra de cobrança com que o pedido nasceu (snapshot). CLIENT = taxa somada
  // ao total; PROVIDER = taxa descontada do repasse de quem atende.
  feeRate         Float       @default(0.08)
  feePayer        String      @default("CLIENT")
  // Código de chegada: gerado no aceite, só o cliente vê; quem atende digita em start_work.
  doorCode         String?
  doorCodeAttempts Int        @default(0)
  // Link público de acompanhamento (modo família), /t/<shareToken>.
  shareToken       String?    @unique
  // Nível de risco da categoria quando o pedido foi criado (snapshot).
  riskLevel        Int        @default(1)
  expectedDurationMin Int?
  overtimeAlertedAt   DateTime?
  // Preferências de quem pede (ex.: idoso): nota mínima, tarefas concluídas, gênero.
  prefMinRating    Float?
  prefMinCompleted Int?
  prefGender       String?
  couponCode      String?
  // Escalonamento da ajuda aberta (Fase 6): 0 normal, 1 âncoras avisados, 2 raio ampliado.
  escalationLevel Int       @default(0)
  escalatedAt     DateTime?
  cancelReason    String?
  acceptedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  // Última posição do prestador reportada durante EN_ROUTE/IN_PROGRESS (RF-E3).
  providerLat        Float?
  providerLng        Float?
  providerLocationAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client   User             @relation("ClientOrders", fields: [clientId], references: [id])
  provider ProviderProfile? @relation("ProviderOrders", fields: [providerId], references: [id])
  service  Service?         @relation(fields: [serviceId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  address       Address   @relation("OrderDropoff", fields: [addressId], references: [id])
  pickupAddress Address?  @relation("OrderPickup", fields: [pickupAddressId], references: [id])
  events   OrderEvent[]
  messages Message[]
  payment  Payment?
  reviews  Review[]
  supportTickets SupportTicket[]
  proposals OrderProposal[]
  appEvents AppEvent[]

  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@index([isOpenRequest, status])
  @@index([pickupAddressId])
  @@map("order")
}

// auditoria da máquina de estados do pedido
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("orderevent")
}

// Orçamento/negociação (RF-D5 + ajuda aberta): chamada profissional em CREATED;
// ajuda aberta em ACCEPTED (não pago) com aceite bilateral do novo valor.
// Só uma proposta PENDING por vez — uma nova marca a anterior como SUPERSEDED.
model OrderProposal {
  id                 String         @id @default(uuid())
  orderId            String
  byRole             String // "client" | "provider" — quem propôs
  priceCents         Int
  note               String?
  status             ProposalStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  respondedAt        DateTime?
  // Ajuda aberta: solicitante confirma primeiro, depois quem ajuda.
  clientAcceptedAt   DateTime?
  providerAcceptedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("orderproposal")
}

// ---------------------------------------------------------------------------
// Chat cliente <-> prestador (por pedido)
// ---------------------------------------------------------------------------

model Message {
  id        String    @id @default(uuid())
  orderId   String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([orderId])
  @@map("message")
}

// ---------------------------------------------------------------------------
// Reputação (avaliação bidirecional)
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  targetId  String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User  @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([orderId, authorId]) // um review por autor por pedido
  @@index([targetId])
  @@map("review")
}

// ---------------------------------------------------------------------------
// Pagamentos e carteira
// ---------------------------------------------------------------------------

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  gatewayRef  String? // id da transação no gateway (Pix/cartão)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  balanceCents Int     @default(0)
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payouts      Payout[]

  @@map("wallet")
}

// Chave Pix de quem atende, para saques.
model PayoutAccount {
  id         String   @id @default(uuid())
  userId     String   @unique
  pixKeyType String // CPF | CNPJ | EMAIL | PHONE | RANDOM
  pixKey     String
  holderName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payoutaccount")
}

// Saque. SIMULATED = registrado e debitado, sem transferência (PAYOUT_PROVIDER=simulated).
model Payout {
  id                 String    @id @default(uuid())
  userId             String
  walletId           String
  amountCents        Int
  feeCents           Int       @default(0)
  netCents           Int
  status             String // SIMULATED | PROCESSING | PAID | FAILED
  provider           String
  providerRef        String?
  pixKeyMasked       String
  balanceBeforeCents Int
  balanceAfterCents  Int
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payout")
}

model WalletTransaction {
  id          String       @id @default(uuid())
  walletId    String
  type        WalletTxType
  amountCents Int
  description String?
  orderId     String?
  createdAt   DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallettransaction")
}

// ---------------------------------------------------------------------------
// Busca por IA conversacional (histórico da conversa)
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("aiconversation")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           AiRole
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("aimessage")
}

// ---------------------------------------------------------------------------
// Vagas de emprego: empresas (ProviderProfile.isCompany=true) publicam vagas
// com escala de trabalho; qualquer usuário autenticado pode se candidatar.
// ---------------------------------------------------------------------------

model JobPosting {
  id           String           @id @default(uuid())
  providerId   String
  categoryId   String
  title        String
  description  String
  contractType JobContractType
  salaryCents  Int? // null = "a combinar"
  status       JobStatus        @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  provider     ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id])
  shifts       JobShift[]
  applications JobApplication[]

  @@index([status, categoryId])
  @@index([providerId])
  @@map("jobposting")
}

// Turno semanal da escala de trabalho (dia + horário). startTime/endTime em
// formato "HH:mm" — mesmo formato que a tool de IA do app já emite.
model JobShift {
  id           String  @id @default(uuid())
  jobPostingId String
  weekday      WeekDay
  startTime    String
  endTime      String

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@map("jobshift")
}

model JobApplication {
  id           String                @id @default(uuid())
  jobPostingId String
  applicantId  String
  message      String?
  status       JobApplicationStatus  @default(PENDING)
  createdAt    DateTime              @default(now())
  respondedAt  DateTime?

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant  User       @relation(fields: [applicantId], references: [id])

  @@unique([jobPostingId, applicantId])
  @@index([applicantId])
  @@map("jobapplication")
}

// ---------------------------------------------------------------------------
// Suporte e disputas (RF-H1/H2): chamados abertos pelo usuário (dúvida geral ou
// contestação vinculada a um pedido), respondidos pelo painel admin.
// ---------------------------------------------------------------------------

enum SupportTicketCategory {
  PAYMENT
  CANCELLATION
  SECURITY
  ACCOUNT
  DISPUTE
  OTHER

  @@map("supportticketcategory")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("supportticketstatus")
}

model SupportTicket {
  id            String                @id @default(uuid())
  userId        String
  orderId       String?
  category      SupportTicketCategory
  subject       String
  message       String
  status        SupportTicketStatus   @default(OPEN)
  adminResponse String?
  resolvedAt    DateTime?
  // Prazo de atendimento (1 h para segurança/disputa) e quando foi escalado.
  slaDueAt      DateTime?
  escalatedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("supportticket")
}

// Selos de quem atende: REPAIRS_SEAL (treino + teste + tarefas) libera nível 2;
// PRO_CREDENTIAL (credencial/registro + seguro de RC) libera nível 3.
model ProviderBadge {
  id         String    @id @default(uuid())
  providerId String
  type       String // REPAIRS_SEAL | PRO_CREDENTIAL
  note       String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, type])
  @@map("providerbadge")
}

// Denúncia de um participante do pedido contra o outro.
model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  orderId        String?
  reason         String // SAFETY | BEHAVIOR | FRAUD | NO_SHOW | OTHER
  details        String?
  status         String   @default("OPEN") // OPEN | REVIEWED
  createdAt      DateTime @default(now())

  @@unique([reporterId, orderId])
  @@index([status, createdAt])
  @@map("report")
}

// Parâmetros de negócio editáveis sem deploy (taxa, TTLs, limiares). Sem linha,
// a API usa os padrões de apps/web/src/lib/config.ts.
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("appconfig")
}

// Trilha de eventos de produto (métricas do piloto). O ciclo do pedido continua
// em OrderEvent; aqui ficam os eventos de produto (ex.: busca sem resultado).
model AppEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  orderId   String?
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
  @@index([orderId])
  @@map("appevent")
}

// Zona de atendimento (Fase 6). Sem zona ativa, o app atende em qualquer lugar.
// polygon = lista de [lat, lng]; horários em minutos do dia (Brasília).
model ServiceZone {
  id          String   @id @default(uuid())
  name        String
  polygon     Json
  weekdays    Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  openMinute  Int      @default(0)
  closeMinute Int      @default(1440)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@map("servicezone")
}

// Turno de âncora (Fase 6): piso por hora proporcional ao tempo disponível.
model AnchorShift {
  id               String    @id @default(uuid())
  providerId       String
  startsAt         DateTime
  endsAt           DateTime
  hourlyFloorCents Int
  onlineMinutes    Int       @default(0)
  lastPresenceAt   DateTime?
  status           String    @default("SCHEDULED") // SCHEDULED | SETTLED | CANCELLED
  earnedCents      Int?
  subsidyCents     Int?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@index([providerId])
  @@map("anchorshift")
}
