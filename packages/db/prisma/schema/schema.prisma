generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  PROVIDER
  BOTH

  @@map("role")
}

enum ProviderStatus {
  PENDING
  APPROVED
  BLOCKED

  @@map("providerstatus")
}

enum OrderStatus {
  CREATED
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED

  @@map("orderstatus")
}

enum PaymentMethod {
  PIX
  CARD
  CASH

  @@map("paymentmethod")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@map("paymentstatus")
}

enum WalletTxType {
  CREDIT
  DEBIT

  @@map("wallettxtype")
}

enum AiRole {
  USER
  ASSISTANT
  TOOL

  @@map("airole")
}

enum NotificationType {
  ORDER
  MESSAGE
  SUPPORT
  JOB

  @@map("notificationtype")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED

  @@map("proposalstatus")
}

enum JobContractType {
  CLT
  PJ
  FREELANCE
  TEMPORARY

  @@map("jobcontracttype")
}

enum JobStatus {
  OPEN
  CLOSED

  @@map("jobstatus")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum JobApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("jobapplicationstatus")
}

// ---------------------------------------------------------------------------
// Identidade e autenticação (auth custom — email/senha via API própria)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role     @default(CLIENT)
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  pushToken     String? // Expo push token do último dispositivo logado (RF-E2)
  // Preferências do centro de notificações in-app (RF-I1) — desligar um tipo
  // suprime tanto a notificação persistida quanto o push desse evento.
  notifyOrders   Boolean  @default(true)
  notifyMessages Boolean  @default(true)
  // Consentimento explícito aos Termos de Uso/Política de Privacidade no cadastro (RNF-4, LGPD).
  termsAcceptedAt DateTime?
  // Marca a conta como excluída (RF-A7) sem quebrar FKs de pedidos/avaliações/mensagens já
  // existentes — os dados pessoais são anonimizados, o registro em si é preservado.
  deletedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerProfile     ProviderProfile?
  addresses           Address[]
  ordersAsClient      Order[]              @relation("ClientOrders")
  reviewsAuthored     Review[]             @relation("ReviewAuthor")
  reviewsReceived     Review[]             @relation("ReviewTarget")
  messages            Message[]
  wallet              Wallet?
  refreshTokens       RefreshToken[]
  aiConversations     AiConversation[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  supportTickets      SupportTicket[]
  jobApplications     JobApplication[]

  @@index([role])
  @@map("user")
}

// Sessão persistida: refresh tokens rotacionáveis (hash guardado, nunca o token puro)
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refreshtoken")
}

// Recuperação de senha (RF-A4): código de 6 dígitos com TTL curto, hash guardado
// (nunca o código puro), mesmo padrão do RefreshToken.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passwordresettoken")
}

// Centro de notificações in-app (RF-I1): espelha cada push disparado pelo domínio
// (novo pedido, transição de status, mensagem de chat) para o usuário poder ver
// o histórico dentro do app, além de receber a notificação do sistema.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Prestador (perfil profissional + KYC)
// ---------------------------------------------------------------------------

model ProviderProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  headline        String? // ex.: "Eletricista"
  bio             String?
  yearsExperience Int            @default(0)
  status          ProviderStatus @default(PENDING)
  isAvailable     Boolean        @default(false)
  // Perfil de pessoa jurídica (empresa) em vez de profissional autônomo.
  isCompany       Boolean        @default(false)
  // Razão social/nome fantasia (isCompany=true) — exibido como dado secundário; o nome
  // principal mostrado ao cliente passa a ser responsibleName nesse caso.
  companyName     String?
  // Nome do responsável pela empresa (isCompany=true) — usado como nome de referência
  // do prestador no lugar do nome da empresa.
  responsibleName String?
  // Empresa (isCompany=true) que está com vagas abertas pra contratar funcionários.
  hiringEmployees Boolean        @default(false)
  // Permite ao cliente propor/receber um orçamento diferente antes do aceite (RF-D5).
  // Desligado por padrão: o fluxo segue direto pra tela de pagamento após criar o pedido.
  allowsNegotiation Boolean      @default(false)
  ratingAvg       Float          @default(0)
  ratingCount     Int            @default(0)
  documentUrl     String? // documento de verificação (KYC) no Supabase Storage
  // localização base + raio de atuação (matching por proximidade)
  baseLat         Float?
  baseLng         Float?
  serviceRadiusKm Float          @default(10)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]
  categories      ProviderCategory[]
  ordersAsProvider Order[]           @relation("ProviderOrders")
  jobPostings     JobPosting[]

  @@index([status, isAvailable])
  @@map("providerprofile")
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  icon      String?
  createdAt DateTime @default(now())

  services   Service[]
  providers  ProviderCategory[]
  orders     Order[]
  jobPostings JobPosting[]

  @@map("category")
}

// join m2m explícito prestador <-> categoria
model ProviderCategory {
  providerId String
  categoryId String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("providercategory")
}

model Service {
  id         String   @id @default(uuid())
  providerId String
  categoryId String
  name       String
  priceCents Int
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@index([providerId])
  @@index([categoryId])
  @@map("service")
}

// ---------------------------------------------------------------------------
// Endereços do cliente (pipeline CEP->endereço->coordenadas)
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @default(uuid())
  userId       String
  label        String? // ex.: "Casa", "Trabalho"
  cep          String?
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  lat          Float // coordenadas resolvidas via Nominatim (1x no cadastro)
  lng          Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("address")
}

// ---------------------------------------------------------------------------
// Pedido / Contratação (coração do marketplace)
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid())
  clientId        String
  providerId      String?
  serviceId       String?
  categoryId      String?
  addressId       String
  description     String?
  status          OrderStatus @default(CREATED)
  scheduledAt     DateTime? // null = "agora"; preenchido = agendado
  priceCents      Int         @default(0)
  platformFeeCents Int        @default(0)
  totalCents      Int         @default(0)
  couponCode      String?
  cancelReason    String?
  acceptedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  // Última posição do prestador reportada durante EN_ROUTE/IN_PROGRESS (RF-E3).
  providerLat        Float?
  providerLng        Float?
  providerLocationAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client   User             @relation("ClientOrders", fields: [clientId], references: [id])
  provider ProviderProfile? @relation("ProviderOrders", fields: [providerId], references: [id])
  service  Service?         @relation(fields: [serviceId], references: [id])
  category Category?        @relation(fields: [categoryId], references: [id])
  address  Address          @relation(fields: [addressId], references: [id])
  events   OrderEvent[]
  messages Message[]
  payment  Payment?
  reviews  Review[]
  supportTickets SupportTicket[]
  proposals OrderProposal[]

  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@map("order")
}

// auditoria da máquina de estados do pedido
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("orderevent")
}

// Orçamento/negociação antes do aceite (RF-D5): enquanto o pedido está CREATED,
// cliente ou prestador podem propor um novo priceCents; a outra parte aceita
// (atualiza o preço do pedido) ou recusa. Só uma proposta PENDING por vez —
// uma nova proposta marca a anterior como SUPERSEDED.
model OrderProposal {
  id          String         @id @default(uuid())
  orderId     String
  byRole      String // "client" | "provider" — quem propôs
  priceCents  Int
  note        String?
  status      ProposalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("orderproposal")
}

// ---------------------------------------------------------------------------
// Chat cliente <-> prestador (por pedido)
// ---------------------------------------------------------------------------

model Message {
  id        String    @id @default(uuid())
  orderId   String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id])

  @@index([orderId])
  @@map("message")
}

// ---------------------------------------------------------------------------
// Reputação (avaliação bidirecional)
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  targetId  String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User  @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([orderId, authorId]) // um review por autor por pedido
  @@index([targetId])
  @@map("review")
}

// ---------------------------------------------------------------------------
// Pagamentos e carteira
// ---------------------------------------------------------------------------

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  gatewayRef  String? // id da transação no gateway (Pix/cartão)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  balanceCents Int     @default(0)
  updatedAt   DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  id          String       @id @default(uuid())
  walletId    String
  type        WalletTxType
  amountCents Int
  description String?
  orderId     String?
  createdAt   DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallettransaction")
}

// ---------------------------------------------------------------------------
// Busca por IA conversacional (histórico da conversa)
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
  @@map("aiconversation")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           AiRole
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("aimessage")
}

// ---------------------------------------------------------------------------
// Vagas de emprego: empresas (ProviderProfile.isCompany=true) publicam vagas
// com escala de trabalho; qualquer usuário autenticado pode se candidatar.
// ---------------------------------------------------------------------------

model JobPosting {
  id           String           @id @default(uuid())
  providerId   String
  categoryId   String
  title        String
  description  String
  contractType JobContractType
  salaryCents  Int? // null = "a combinar"
  status       JobStatus        @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  provider     ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id])
  shifts       JobShift[]
  applications JobApplication[]

  @@index([status, categoryId])
  @@index([providerId])
  @@map("jobposting")
}

// Turno semanal da escala de trabalho (dia + horário). startTime/endTime em
// formato "HH:mm" — mesmo formato que a tool de IA do app já emite.
model JobShift {
  id           String  @id @default(uuid())
  jobPostingId String
  weekday      WeekDay
  startTime    String
  endTime      String

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@map("jobshift")
}

model JobApplication {
  id           String                @id @default(uuid())
  jobPostingId String
  applicantId  String
  message      String?
  status       JobApplicationStatus  @default(PENDING)
  createdAt    DateTime              @default(now())
  respondedAt  DateTime?

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant  User       @relation(fields: [applicantId], references: [id])

  @@unique([jobPostingId, applicantId])
  @@index([applicantId])
  @@map("jobapplication")
}

// ---------------------------------------------------------------------------
// Suporte e disputas (RF-H1/H2): chamados abertos pelo usuário (dúvida geral ou
// contestação vinculada a um pedido), respondidos pelo painel admin.
// ---------------------------------------------------------------------------

enum SupportTicketCategory {
  PAYMENT
  CANCELLATION
  SECURITY
  ACCOUNT
  DISPUTE
  OTHER

  @@map("supportticketcategory")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("supportticketstatus")
}

model SupportTicket {
  id            String                @id @default(uuid())
  userId        String
  orderId       String?
  category      SupportTicketCategory
  subject       String
  message       String
  status        SupportTicketStatus   @default(OPEN)
  adminResponse String?
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("supportticket")
}
