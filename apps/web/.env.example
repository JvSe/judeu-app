# === Banco (Supabase Postgres) ===
# DATABASE_URL: pooler de TRANSAÇÃO (porta 6543, ?pgbouncer=true) — runtime do app.
# DIRECT_URL:  pooler de SESSÃO (porta 5432) — usado por migrations / prisma db push.
# Ambos em: Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres.xxxx:[SENHA]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:[SENHA]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Origem permitida para CORS (app nativo em dev usa o Expo; a API é chamada pelo app)
CORS_ORIGIN=http://localhost:3001

# === Auth custom (JWT) ===
# Gere segredos fortes, ex.: `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-32+chars
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-de-32+chars

# === Supabase Storage (imagens: avatar, KYC, portfólio) ===
# Project Settings > API. Crie um bucket PRIVADO chamado "kyc-documents" (Storage > New bucket,
# "Public bucket" desligado) — é onde o documento de identidade do prestador é gravado.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui

# === Busca por IA (Claude) — somente no servidor, nunca no app ===
ANTHROPIC_API_KEY=sk-ant-...

# === Geo (projeto de demonstração — serviços públicos, sem self-host) ===
# Nominatim público: sujeito a 1 req/s e uso apenas leve/não-comercial.
# OSRM demo server: sem SLA, só perfil "driving", pode sair do ar sem aviso.
# Pra produção real, ver apps/geo/README.md (self-host na Railway).
#
# Provedores (padrão = o de sempre): ROUTING_PROVIDER=osrm|valhalla|google,
# GEOCODING_PROVIDER=nominatim|google. Troque quando /admin/metrics indicar
# (ETA erra > 20% ou endereço não encontrado > 3%).
ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=nominatim
# OSRM: OSRM_URL; se vazio, usa VALHALLA_URL (legado) e depois o servidor público.
OSRM_URL=https://router.project-osrm.org
# Valhalla próprio (apps/geo) — usado com ROUTING_PROVIDER=valhalla.
VALHALLA_URL=
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Google Routes / Geocoding — só com o provedor "google".
GOOGLE_MAPS_API_KEY=

# === Pagamentos (Stripe) — Pix/cartão cobrados na conta da plataforma ===
# Dashboard > Developers > API keys (use as chaves de TESTE em dev)
STRIPE_SECRET_KEY=sk_test_...
# Dashboard > Developers > Webhooks (ou `stripe listen` no CLI) — opcional em dev
STRIPE_WEBHOOK_SECRET=whsec_...

# === Painel admin (/admin) — moderação de KYC dos prestadores ===
# Senha única (sem conta de admin por ora). Acesse /admin/login.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# === Job agendado (POST /api/cron/tick, disparado pelo pg_cron) ===
# Mínimo 32 caracteres; gere com `openssl rand -hex 32`. O mesmo valor vai para o
# Vault do Supabase (ver packages/db/supabase/rpcs/004_cron_tick.sql). Vazio = endpoint desligado.
CRON_SECRET=

# === E-mail transacional (Resend) — código de recuperação de senha ===
# Sem estas duas, o código só aparece no log do servidor (ok em dev).
RESEND_API_KEY=
MAIL_FROM="Ajuda+ <nao-responda@seu-dominio.com.br>"

# === Modo família ===
# URL pública desta API/web, usada nos links /t/<token> enviados por e-mail.
PUBLIC_WEB_URL=http://localhost:3001
# E-mail da equipe que recebe alerta imediato do botão de emergência.
SECURITY_ALERT_EMAIL=
