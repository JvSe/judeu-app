# URL da API (apps/web). Deixe em branco/ausente em dev com simulador/emulador —
# o app detecta o host certo por plataforma automaticamente (ver lib/api.ts).
# Só defina para testar em dispositivo físico (IP da sua máquina, ex.: http://192.168.0.10:3001)
# ou em build de produção (URL do backend implantado).
EXPO_PUBLIC_SERVER_URL=

# Chave pública do Stripe (PaymentSheet do cartão) — Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
