# URL da API (apps/web). Em dev com dispositivo físico, use o IP da sua máquina
# (ex.: http://192.168.0.10:3001), não localhost.
EXPO_PUBLIC_SERVER_URL=http://localhost:3001

# Chave do MapTiler para os tiles do mapa (MapLibre) — incremento de mapa
EXPO_PUBLIC_MAPTILER_KEY=

# Chave pública do Stripe (PaymentSheet do cartão) — Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
