diff --git a/android/src/main/cpp/CMakeLists.txt b/android/src/main/cpp/CMakeLists.txt
index dfbf74ae3eb88ed4c781ab69c85d0e2edc110437..a849661d8c708a7ec4bca3bf80d837769f9d56a8 100644
--- a/android/src/main/cpp/CMakeLists.txt
+++ b/android/src/main/cpp/CMakeLists.txt
@@ -6,8 +6,43 @@ file(GLOB_RECURSE COMMON_C_SOURCES CONFIGURE_DEPENDS "${COMMON_CPP_DIR}/*.c")
 file(GLOB_RECURSE TEST_CPP_SOURCES "${COMMON_CPP_DIR}/rnexecutorch/tests/*.cpp")
 list(REMOVE_ITEM COMMON_CPP_SOURCES ${TEST_CPP_SOURCES})
 
+# Judeu only uses the on-device LLM. Compiling the rest of the model zoo
+# (OCR, vision, speech, TTS) blows past the EAS free-plan Android time limit.
+set(EXECUTORCH_SKIP_MODELS
+  classification
+  embeddings
+  instance_segmentation
+  object_detection
+  ocr
+  pose_estimation
+  privacy_filter
+  semantic_segmentation
+  speech_to_text
+  style_transfer
+  text_to_image
+  text_to_speech
+  vertical_ocr
+  voice_activity_detection
+)
+foreach(model ${EXECUTORCH_SKIP_MODELS})
+  list(FILTER COMMON_CPP_SOURCES EXCLUDE REGEX "/models/${model}/")
+endforeach()
+list(FILTER COMMON_CPP_SOURCES EXCLUDE REGEX "/models/VisionModel\\.cpp$")
+
 add_library(react-native-executorch SHARED ${ANDROID_CPP_SOURCES} ${COMMON_CPP_SOURCES} ${COMMON_C_SOURCES})
 
+# RelWithDebInfo is -O2 -g. These translation units are dominated by ExecuTorch
+# headers, and that combination is what stalls the EAS Gradle step.
+target_compile_options(react-native-executorch PRIVATE -O1 -g0 -Wno-deprecated-declarations)
+
+# ModelHostObject.h still includes Kokoro.h, which includes phonemis headers.
+# The phonemis library itself is not compiled or linked.
+target_include_directories(
+  react-native-executorch
+  PUBLIC
+  "${COMMON_THIRD_PARTY_DIR}/phonemis/src"
+)
+
 find_package(ReactAndroid REQUIRED CONFIG)
 find_package(fbjni REQUIRED CONFIG)
 
